        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina del llavero la frase de contraseña guardada para 1 archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase secrète enregistrée pour 1 fichier est supprimée du trousseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件のファイルに保存されたパスフレーズがキーチェーンから削除されます。"
