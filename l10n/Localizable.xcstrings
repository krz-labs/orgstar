    "Write commands in JavaScript in commands.toml. They appear with orgstar's own commands, can run them, and can run after a TODO changes or before a capture is filed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie Befehle in JavaScript in commands.toml. Sie erscheinen neben den Befehlen von orgstar, können diese ausführen und nach einer TODO-Änderung oder vor dem Ablegen einer Erfassung laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe comandos en JavaScript en commands.toml. Aparecen junto a los comandos de orgstar, pueden ejecutarlos y pueden ejecutarse después de un cambio de TODO o antes de archivar una captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez des commandes en JavaScript dans commands.toml. Elles apparaissent avec les commandes d'orgstar, peuvent les exécuter et peuvent s'exécuter après un changement de TODO ou avant l'enregistrement d'une capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "commands.toml で JavaScript のコマンドを書けます。orgstar のコマンドと並んで表示され、それらを実行でき、TODO の変更後やキャプチャの保存前に実行することもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva comandos em JavaScript no commands.toml. Eles aparecem junto aos comandos do orgstar, podem executá-los e podem rodar depois que um TODO muda ou antes de uma captura ser arquivada."
          }
        }
      }
    },
