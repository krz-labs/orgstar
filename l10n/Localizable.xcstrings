    "Files open, parse and are styled faster, and typing in long files stays smooth.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien öffnen sich schneller und werden schneller gelesen und formatiert, und das Tippen in langen Dateien bleibt flüssig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se abren, se analizan y se les da estilo más rápido, y escribir en archivos largos sigue siendo fluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers s'ouvrent, sont analysés et mis en forme plus vite, et la saisie dans les longs fichiers reste fluide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開く、解析する、表示を整える処理が速くなり、長いファイルでも入力が滑らかです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos abrem, são analisados e formatados mais rápido, e digitar em arquivos longos continua fluido."
          }
        }
      }
    },
