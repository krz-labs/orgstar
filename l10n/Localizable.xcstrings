          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（orgstar+）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (orgstar+)"
          }
        }
      }
    },
    "%@ / month": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / Monat"
          }
        },
        "es": {
