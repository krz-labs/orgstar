          }
        }
      }
    },
    "%@ / year": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / Jahr"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / año"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / an"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / 年"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / ano"
          }
        }
      }
    },
    "%@ a month, billed yearly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Monat, jährliche Abrechnung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mes, facturado anualmente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par mois, facturé annuellement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額%@、年払い"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por mês, cobrado anualmente"
          }
        }
      }
    },
    "%@ ago": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vor %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "hace %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "il y a %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@前"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "há %@"
          }
        }
      }
    },
    "%@ blocks draw only SVG and PNG files in this version of orgstar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Blöcke zeichnen in dieser Version von orgstar nur SVG- und PNG-Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bloques de %@ solo dibujan archivos SVG y PNG en esta versión de orgstar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les blocs %@ ne dessinent que des fichiers SVG et PNG dans cette version d'orgstar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのorgstarでは、%@ブロックはSVGとPNGのファイルのみ描画します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocos de %@ só desenham arquivos SVG e PNG nesta versão do orgstar."
          }
        }
      }
    },
    "%@ blocks with this :cmdline don't run in this version of orgstar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Blöcke mit diesem :cmdline laufen in dieser Version von orgstar nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bloques de %@ con este :cmdline no se ejecutan en esta versión de orgstar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les blocs %@ avec ce :cmdline ne s'exécutent pas dans cette version d'orgstar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この:cmdlineを持つ%@ブロックは、このバージョンのorgstarでは実行できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocos de %@ com este :cmdline não rodam nesta versão do orgstar."
          }
        }
      }
    },
    "%@ can't be a TODO keyword: it has a space, a bar or a parenthesis.": {
      "comment": "Rename TODO Keyword",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann kein TODO-Schlüsselwort sein: Es enthält ein Leerzeichen, einen Strich oder eine Klammer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede ser una palabra clave TODO: tiene un espacio, una barra o un paréntesis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas être un mot-clé TODO : il contient une espace, une barre ou une parenthèse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は TODO キーワードにできません: 空白、縦棒、括弧を含んでいます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode ser uma palavra-chave TODO: tem um espaço, uma barra ou um parêntese."
          }
        }
      }
    },
    "%@ can't be a tag: a tag is letters, digits, _, @, # and %%.": {
      "comment": "Rename Tag",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann kein Tag sein: Ein Tag besteht aus Buchstaben, Ziffern, _, @, # und %%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede ser una etiqueta: una etiqueta tiene letras, dígitos, _, @, # y %%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas être une étiquette : une étiquette contient des lettres, des chiffres, _, @, # et %%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はタグにできません: タグは文字、数字、_、@、#、%% だけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode ser uma etiqueta: uma etiqueta tem letras, dígitos, _, @, # e %%."
          }
        }
      }
    },
    "%@ can't run here": {
      "comment": "A command that doesn't apply in column view",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann hier nicht ausgeführt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se puede ejecutar aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'exécuter %@ ici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はここでは実行できません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível executar %@ aqui"
          }
        }
      }
    },
    "%@ canceled.": {
      "comment": "A user command canceled with Cancel Running Task",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl %@ abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando %@ cancelado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande %@ annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド「%@」をキャンセルしました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando %@ cancelado."
          }
        }
      }
    },
    "%@ changed before %@ ran, so it didn't run.": {
      "comment": "An after-todo-state-change hook not run because its file changed",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat sich geändert, bevor %2$@ lief, daher wurde der Hook nicht ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cambió antes de que se ejecutara %2$@, así que no se ejecutó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a changé avant l’exécution de %2$@, qui n’a donc pas été exécuté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の実行前に %1$@ が変更されたため、実行しませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mudou antes de %2$@ ser executado, então ele não foi executado."
          }
        }
      }
    },
    "%@ changed on disk while saving, and the changes conflict with yours; both are in the editor between conflict markers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde beim Sichern auf dem Datenträger geändert, und die Änderungen widersprechen deinen; beide stehen im Editor zwischen Konfliktmarkierungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» cambió en el disco mientras se guardaba y los cambios entran en conflicto con los tuyos; ambos están en el editor entre marcas de conflicto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a changé sur le disque pendant l'enregistrement, et les modifications sont en conflit avec les vôtres ; les deux sont dans l'éditeur entre des marqueurs de conflit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中に“%@”がディスク上で変更され、あなたの変更と競合しています。両方がコンフリクトマーカーで囲まれてエディタにあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" mudou no disco durante o salvamento, e as alterações conflitam com as suas; ambas estão no editor entre marcadores de conflito."
          }
        }
      }
    },
    "%@ changed while %@ ran; its changes weren't made.": {
      "comment": "An after-todo-state-change hook's edits refused because its file changed",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat sich geändert, während %2$@ lief; seine Änderungen wurden nicht vorgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cambió mientras se ejecutaba %2$@; sus cambios no se aplicaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a changé pendant l’exécution de %2$@ ; ses modifications n’ont pas été appliquées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の実行中に %1$@ が変更されたため、その変更は反映されませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mudou enquanto %2$@ era executado; as alterações dele não foram feitas."
          }
        }
      }
    },
    "%@ didn't finish within %lld s and was stopped.": {
      "comment": "A user command passed its time limit",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl %1$@ wurde nicht innerhalb von %2$lld s fertig und wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando %1$@ no terminó en %2$lld s y se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande %1$@ ne s’est pas terminée en %2$lld s et a été arrêtée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド「%1$@」は%2$lld秒以内に終わらなかったため停止しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando %1$@ não terminou em %2$lld s e foi interrompido."
          }
        }
      }
    },
    "%@ doesn't contain %@.": {
      "comment": "Alert when the folder chosen to grant access doesn't contain the one needed",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ enthält %2$@ nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ doesn't contain %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no contiene %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne contient pas %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@には%2$@が含まれていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não contém %2$@."
          }
        }
      }
    },
    "%@ has another passphrase; open it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat ein anderes Passwort; öffne die Datei zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» tiene otra frase de contraseña; ábrelo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a une autre phrase secrète ; ouvrez-le d'abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”のパスフレーズは異なります。先に開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" tem outra senha; abra-o primeiro."
          }
        }
      }
    },
    "%@ has decrypted entries that are encrypted on disk, so Emacs isn't given a copy of it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat entschlüsselte Einträge, die auf dem Datenträger verschlüsselt sind, daher erhält Emacs keine Kopie davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» tiene entradas descifradas que están cifradas en el disco, así que Emacs no recibe una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » contient des entrées déchiffrées qui sont chiffrées sur le disque, donc Emacs n'en reçoit pas de copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”にはディスク上で暗号化されている復号済みエントリがあるため、Emacsにはコピーを渡しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" tem entradas descriptografadas que estão criptografadas no disco, então o Emacs não recebe uma cópia."
          }
        }
      }
    },
    "%@ has decrypted entries, so user commands don't run in it.": {
      "comment": "A user command refused in a buffer holding decrypted text",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält entschlüsselte Einträge, daher laufen eigene Befehle darin nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene entradas descifradas, así que los comandos propios no se ejecutan en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contient des entrées déchiffrées, les commandes personnelles ne s’y exécutent donc pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には復号されたエントリがあるため、ユーザーコマンドは実行されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem entradas descriptografadas, então comandos do usuário não são executados nele."
          }
        }
      }
    },
    "%@ in %lld of %lld files": {
      "comment": "Lint All Folders: the number of problems, files with problems, files checked",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in %lld von %lld Dateien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %lld de %lld archivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
