    "A template's key in capture.toml; the first template when empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kürzel einer Vorlage in capture.toml; leer für die erste Vorlage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
