          "stringUnit": {
            "state": "translated",
            "value": "Für Dateien ohne #+TODO, in #+TODO-Syntax, eine Folge pro Zeile. Gilt nach einem Neustart von orgstar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para archivos sin #+TODO, en sintaxis #+TODO, una secuencia por línea. Se aplica al reiniciar orgstar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les fichiers sans #+TODO, en syntaxe #+TODO, une séquence par ligne. Prend effet au redémarrage d'orgstar."
          }
        },
        "ja": {
          "stringUnit": {
