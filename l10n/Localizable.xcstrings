    "An entry can't become done while a descendant has an active TODO keyword, or, under a parent with the ORDERED property, while an earlier sibling has one.": {
      "comment": "Help for a config.toml setting",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Eintrag kann nicht erledigt werden, solange ein Nachfahre ein aktives TODO-Schlüsselwort hat oder, unter einem Elterneintrag mit der Eigenschaft ORDERED, ein früherer Geschwistereintrag eines hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una entrada no puede completarse mientras una descendiente tenga una palabra clave TODO activa ni, bajo un padre con la propiedad ORDERED, mientras la tenga una hermana anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entrée ne peut pas être terminée tant qu'un descendant a un mot-clé TODO actif, ou, sous un parent ayant la propriété ORDERED, tant qu'une entrée sœur précédente en a un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "子孫にアクティブなTODOキーワードがある間、またはORDEREDプロパティを持つ親の下で前の兄弟にある間は、エントリを完了にできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma entrada não pode ser concluída enquanto um descendente tiver uma palavra-chave TODO ativa nem, sob um pai com a propriedade ORDERED, enquanto um irmão anterior tiver uma."
          }
        }
      }
    },
    "An entry can't become done while its text has an unchecked checkbox.": {
      "comment": "Help for a config.toml setting",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Eintrag kann nicht erledigt werden, solange sein Text ein offenes Kontrollkästchen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una entrada no puede completarse mientras su texto tenga una casilla sin marcar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entrée ne peut pas être terminée tant que son texte a une case non cochée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文に未チェックのチェックボックスがある間は、エントリを完了にできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma entrada não pode ser concluída enquanto o texto dela tiver uma caixa de seleção desmarcada."
          }
        }
      }
    },
    "An entry's APPT_WARNTIME property overrides the lead time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eigenschaft APPT_WARNTIME eines Eintrags ersetzt die Vorlaufzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propiedad APPT_WARNTIME de una entrada sustituye la antelación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La propriété APPT_WARNTIME d'une entrée remplace le délai d'avertissement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリのAPPT_WARNTIMEプロパティは事前通知時間より優先されます。"
          }
