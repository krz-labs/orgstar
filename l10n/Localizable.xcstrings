    "Apps that may capture, clock in and out, and read your agenda and clock through orgstar:// x-callback-url links without asking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die über orgstar://-x-callback-url-Links ohne Nachfrage erfassen, die Zeiterfassung starten und stoppen und deine Agenda und Uhr lesen dürfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que pueden capturar, iniciar y detener el reloj y leer tu agenda y tu reloj mediante enlaces x-callback-url de orgstar:// sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps qui peuvent capturer, démarrer et arrêter le chronomètre, et lire votre agenda et votre chronomètre via des liens x-callback-url orgstar:// sans demander."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar:// の x-callback-url リンクを通じて、確認なしでキャプチャ、クロックの開始と停止、アジェンダとクロックの読み取りができるApp。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que podem capturar, iniciar e parar o relógio e ler sua agenda e seu relógio por links x-callback-url orgstar:// sem perguntar."
          }
        }
      }
    },
