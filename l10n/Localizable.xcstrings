    "Edits to %@ weren't saved: they were waiting for a passphrase when orgstar was closed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an %@ wurden nicht gesichert: Sie warteten auf ein Passwort, als orgstar beendet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en %@ no se guardaron: esperaban una frase de contraseña cuando orgstar se cerró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de %@ n'ont pas été enregistrées : elles attendaient une phrase secrète quand orgstar a été fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@への編集は保存されませんでした。orgstarが終了したとき、パスフレーズの入力を待っていました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações em %@ não foram salvas: aguardavam uma senha quando o orgstar foi fechado."
          }
        }
      }
    },
