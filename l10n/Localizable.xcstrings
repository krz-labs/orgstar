          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez un dossier qui est un dépôt git via Working Copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git リポジトリのフォルダを Working Copy 経由で同期できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize uma pasta que é um repositório git pelo Working Copy."
          }
        }
      }
    },
    "Sync folders that are git repositories in Working Copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner synchronisieren, die Git-Repositorys in Working Copy sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza carpetas que son repositorios git en Working Copy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser les dossiers qui sont des dépôts git dans Working Copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Working Copyのgitリポジトリであるフォルダを同期します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize pastas que são repositórios git no Working Copy."
          }
        }
      }
    },
    "Sync saves every file, then Working Copy commits every changed file in the repository, pulls and pushes. The repository is its name in Working Copy's list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Synchronisieren werden alle Dateien gesichert; dann committet Working Copy jede geänderte Datei im Repository, führt Pull und dann Push aus. Als Repository gilt sein Name in der Liste von Working Copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al sincronizar se guardan todos los archivos; luego Working Copy hace commit de cada archivo cambiado del repositorio, pull y push. El repositorio es su nombre en la lista de Working Copy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation enregistre tous les fichiers, puis Working Copy fait un commit de chaque fichier modifié du dépôt, un pull et un push. Le dépôt est son nom dans la liste de Working Copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期するとすべてのファイルが保存され、Working Copyがリポジトリ内の変更されたファイルをすべてコミットし、プルしてからプッシュします。リポジトリにはWorking Copyの一覧に表示される名前を指定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar salva todos os arquivos; depois o Working Copy faz commit de cada arquivo alterado no repositório, pull e push. O repositório é o nome dele na lista do Working Copy."
          }
        }
      }
    },
