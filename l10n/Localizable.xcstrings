    },
    "The org-agenda-todo-ignore settings apply to TODO-only tag matches (M) too, not only to the TODO list.": {
      "comment": "Help for a config.toml setting",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die org-agenda-todo-ignore-Einstellungen gelten auch für reine TODO-Tag-Treffer (M), nicht nur für die TODO-Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes org-agenda-todo-ignore también se aplican a las coincidencias de etiquetas solo TODO (M), no solo a la lista TODO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages org-agenda-todo-ignore s'appliquent aussi aux correspondances de tags TODO uniquement (M), pas seulement à la liste TODO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "org-agenda-todo-ignore設定を、TODOリストだけでなくTODOのみのタグマッチ（M）にも適用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes org-agenda-todo-ignore também se aplicam às correspondências de etiquetas só de TODO (M), não só à lista TODO."
          }
        }
      }
    },
    "The passphrase saved for 1 file is removed from the Keychain.": {
