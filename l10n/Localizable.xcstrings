    "%@ is encrypted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist verschlüsselt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está cifrado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est chiffré"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は暗号化されています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" está criptografado"
          }
        }
      }
    },
    "%@ is encrypted, and %@ isn't; the entry wasn't moved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist verschlüsselt, „%2$@“ nicht; der Eintrag wurde nicht verschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está cifrado y «%2$@» no; la entrada no se movió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est chiffré, « %2$@ » ne l'est pas ; l'entrée n'a pas été déplacée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”は暗号化されていますが“%2$@”はされていないため、エントリは移動しませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" está criptografado e \"%2$@\" não; a entrada não foi movida."
          }
        }
      }
    },
    "%@ is encrypted, so Emacs isn't given a copy of it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist verschlüsselt, daher erhält Emacs keine Kopie davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está cifrado, así que Emacs no recibe una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est chiffré, donc Emacs n'en reçoit pas de copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は暗号化されているため、Emacsにはコピーを渡しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" está criptografado, então o Emacs não recebe uma cópia."
          }
        }
      }
    },
    "%@ is encrypted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está cifrado."
          }
        },
