          }
        }
      }
    },
    "There is already a view named %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits eine Ansicht namens %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una vista llamada %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe déjà une vue nommée %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
