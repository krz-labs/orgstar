    "Set colors under [theme] (both appearances), [theme.light] or [theme.dark] in config.toml, and TODO keyword colors under [theme.todo]. default-theme.toml lists every color with the default theme's values.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Farben in config.toml unter [theme] (beide Darstellungen), [theme.light] oder [theme.dark] fest, und Farben für TODO-Schlüsselwörter unter [theme.todo]. default-theme.toml listet jede Farbe mit den Werten des Standardthemas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define los colores en config.toml en [theme] (ambas apariencias), [theme.light] o [theme.dark], y los colores de las palabras clave TODO en [theme.todo]. default-theme.toml enumera todos los colores con los valores del tema por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez les couleurs sous [theme] (les deux apparences), [theme.light] ou [theme.dark] dans config.toml, et les couleurs des mots-clés TODO sous [theme.todo]. default-theme.toml liste chaque couleur avec les valeurs du thème par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "config.tomlの[theme]（両方の外観）、[theme.light]、または[theme.dark]で色を設定し、TODOキーワードの色は[theme.todo]で設定します。default-theme.tomlには、デフォルトテーマの値ですべての色が記載されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina cores em config.toml em [theme] (ambas as aparências), [theme.light] ou [theme.dark], e as cores das palavras-chave TODO em [theme.todo]. default-theme.toml lista todas as cores com os valores do tema padrão."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes"
          }
        }
      }
    },
    "Settings ▸ Appearance ▸ Size now enlarges the agenda and the sidebars as well as the editor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen ▸ Darstellung ▸ Größe vergrößert jetzt neben dem Editor auch die Agenda und die Seitenleisten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes ▸ Apariencia ▸ Tamaño ahora agranda la agenda y las barras laterales además del editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages ▸ Apparence ▸ Taille agrandit désormais l'agenda et les barres latérales en plus de l'éditeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 ▸ 外観 ▸ サイズ で、エディタに加えてアジェンダとサイドバーも大きくなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes ▸ Aparência ▸ Tamanho agora aumenta a agenda e as barras laterais, além do editor."
          }
        }
      }
    },
    "Settings ▸ General ▸ Install Command-Line Tool… adds an orgstar command for the agenda, capture, clocking and export.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen ▸ Allgemein ▸ Befehlszeilenwerkzeug installieren … fügt einen orgstar-Befehl für Agenda, Erfassen, Zeiterfassung und Export hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes ▸ General ▸ Instalar herramienta de línea de comandos… añade un comando orgstar para la agenda, la captura, el reloj y la exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages ▸ Général ▸ Installer l’outil en ligne de commande… ajoute une commande orgstar pour l’agenda, la capture, le chronomètre et l’export."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 ▸ 一般 ▸ コマンドラインツールをインストール… で、アジェンダ、キャプチャ、クロック、書き出し用の orgstar コマンドが追加されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes ▸ Geral ▸ Instalar Ferramenta de Linha de Comando… adiciona um comando orgstar para a agenda, captura, relógio e exportação."
          }
        }
      }
    },
    "Settings ▸ General ▸ Keep orgstar in the menu bar adds capture, the agenda and today's entries to the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen ▸ Allgemein ▸ orgstar in der Menüleiste behalten fügt der Menüleiste Erfassen, die Agenda und die heutigen Einträge hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes ▸ General ▸ Mantener orgstar en la barra de menús añade la captura, la agenda y las entradas de hoy a la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages ▸ Général ▸ Garder orgstar dans la barre des menus ajoute la capture, l'agenda et les entrées du jour à la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 ▸ 一般 ▸ orgstarをメニューバーに常に表示で、キャプチャ、アジェンダ、今日のエントリをメニューバーに追加します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes ▸ Geral ▸ Manter o orgstar na barra de menus adiciona a captura, a agenda e as entradas de hoje à barra de menus."
          }
        }
      }
    },
