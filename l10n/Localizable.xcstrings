    "This can't be done from a notification.": {
      "comment": "A reminder's action that needs the app",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geht nicht aus einer Mitteilung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede hacer desde una notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible depuis une notification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは通知からは実行できません。"
