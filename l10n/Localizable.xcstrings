    "What's left of today's agenda.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was von der heutigen Agenda übrig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que queda de la agenda de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste de l'agenda du jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のアジェンダの残り。"
          }
        },
        "pt-BR": {
