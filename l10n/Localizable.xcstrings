        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta e seus arquivos permanecem no disco."
          }
        }
      }
    },
    "The folder and its files stay where they are. orgstar stops reading them, and the agenda leaves them out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner und seine Dateien bleiben, wo sie sind. orgstar liest sie nicht mehr, und die Agenda lässt sie aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta y sus archivos se quedan donde están. orgstar deja de leerlos y la agenda los omite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier et ses fichiers restent où ils sont. orgstar cesse de les lire et l'agenda les laisse de côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダとそのファイルは今の場所に残ります。orgstarはそれらを読まなくなり、アジェンダにも表示されません。"
          }
        },
        "pt-BR": {
