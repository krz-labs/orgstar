    "Working Copy runs orgstar's sync only with the URL key from Working Copy's settings. orgstar keeps it in the Keychain on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Working Copy führt die Synchronisierung von orgstar nur mit dem URL-Schlüssel aus den Einstellungen von Working Copy aus. orgstar bewahrt ihn im Schlüsselbund auf diesem Gerät auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Working Copy solo ejecuta la sincronización de orgstar con la clave URL de los ajustes de Working Copy. orgstar la guarda en el llavero de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Working Copy n’exécute la synchronisation d’orgstar qu’avec la clé URL des réglages de Working Copy. orgstar la conserve dans le trousseau de cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Working CopyはWorking Copyの設定にあるURLキーがある場合にのみorgstarの同期を実行します。orgstarはこのキーをこのデバイスのキーチェーンに保管します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Working Copy só executa a sincronização do orgstar com a chave de URL dos ajustes do Working Copy. O orgstar a guarda nas Chaves deste dispositivo."
          }
        }
      }
    },
