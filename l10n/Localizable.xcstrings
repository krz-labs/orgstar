    "an entry can't be done before its TODO children, or under an ORDERED parent before its earlier siblings": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein Eintrag kann nicht vor seinen TODO-Untereinträgen erledigt werden, unter einem ORDERED-Elterneintrag nicht vor seinen früheren Geschwistereinträgen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "una entrada no puede completarse antes que sus hijas TODO, ni bajo un padre ORDERED antes que sus hermanas anteriores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "une entrée ne peut pas être terminée avant ses sous-entrées TODO, ni, sous un parent ORDERED, avant ses entrées sœurs précédentes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TODOの子エントリより先に、またはORDEREDの親の下では前の兄弟より先に、エントリを完了にできない"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "uma entrada não pode ser concluída antes dos filhos TODO, nem sob um pai ORDERED antes dos irmãos anteriores"
          }
        }
      }
    },
