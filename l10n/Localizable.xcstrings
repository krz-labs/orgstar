    "Under a parent with the ORDERED property (Org ▸ Properties and Columns ▸ Toggle ORDERED Property), TODO children are also done in order.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter einem Eintrag mit der Eigenschaft ORDERED (Org ▸ Eigenschaften und Spalten ▸ ORDERED umschalten) werden TODO-Untereinträge auch der Reihe nach erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajo una entrada padre con la propiedad ORDERED (Org ▸ Propiedades y columnas ▸ Alternar propiedad ORDERED), las hijas TODO también se completan en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous un parent ayant la propriété ORDERED (Org ▸ Propriétés et colonnes ▸ Basculer la propriété ORDERED), les sous-entrées TODO sont aussi terminées dans l'ordre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ORDEREDプロパティを持つ親（Org ▸ プロパティと列 ▸ ORDEREDプロパティを切り替え）の下では、TODOの子エントリも順番に完了する必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sob um pai com a propriedade ORDERED (Org ▸ Propriedades e Colunas ▸ Alternar Propriedade ORDERED), os filhos TODO também são concluídos em ordem."
          }
        }
      }
    },
