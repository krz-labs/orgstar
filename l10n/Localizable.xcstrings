            "value": "新しいDenoteメモで尋ねる項目、順番にスペース区切り：title keywords subdirectory date template signature"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o que uma nota nova do Denote pergunta, em ordem, separado por espaços: title keywords subdirectory date template signature"
          }
        }
      }
    },
    "what a new daily note starts with, under its ID": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "womit eine neue Tagesnotiz beginnt, unter ihrer ID"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "con qué empieza una nota diaria nueva, bajo su ID"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ce par quoi commence une nouvelle note quotidienne, sous son ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいデイリーノートの初期内容（IDの下）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "com o que uma nota diária nova começa, abaixo do ID"
          }
        }
      }
    },
    "what log mode shows, separated by spaces: closed, clock, state": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "was der Protokollmodus zeigt, getrennt durch Leerzeichen: closed, clock, state"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "lo que muestra el modo de registro, separado por espacios: closed, clock, state"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ce qu'affiche le mode journal, séparé par des espaces : closed, clock, state"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログモードで表示するもの、スペース区切り：closed、clock、state"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o que o modo de registro mostra, separado por espaços: closed, clock, state"
          }
        }
      }
    },
    "where Archive Subtree moves an entry without an ARCHIVE property or #+ARCHIVE: file::heading, %s the file's name": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wohin „Teilbaum archivieren“ einen Eintrag ohne ARCHIVE-Eigenschaft oder #+ARCHIVE: verschiebt: file::heading, %s der Name der Datei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "adónde mueve Archivar subárbol una entrada sin propiedad ARCHIVE ni #+ARCHIVE: archivo::encabezado, %s el nombre del archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "où Archiver le sous-arbre déplace une entrée sans propriété ARCHIVE ni #+ARCHIVE: : file::heading, %s le nom du fichier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ARCHIVEプロパティや#+ARCHIVE:のないエントリをサブツリーをアーカイブで移動する先、file::heading形式。%sはファイル名"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "para onde Arquivar Subárvore move uma entrada sem propriedade ARCHIVE nem #+ARCHIVE: arquivo::cabeçalho, %s o nome do arquivo"
          }
        }
      }
    },
    "where Combine Agenda Files into iCalendar writes": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wohin „Agenda-Dateien in iCalendar zusammenfassen“ schreibt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "dónde escribe Combinar archivos de agenda en iCalendar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "où écrit Combiner les fichiers d'agenda en iCalendar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アジェンダファイルをiCalendarにまとめるの書き出し先"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "onde Combinar Arquivos da Agenda em iCalendar grava"
          }
        }
      }
    },
    "where pasted images go: attach (the entry's attachments) or a folder, relative to the org file's folder unless absolute": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wohin eingesetzte Bilder kommen: attach (die Anhänge des Eintrags) oder ein Ordner, relativ zum Ordner der Org-Datei, sofern nicht absolut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "dónde van las imágenes pegadas: attach (los adjuntos de la entrada) o una carpeta, relativa a la carpeta del archivo Org salvo que sea absoluta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "où vont les images collées : attach (les pièces jointes de l'entrée) ou un dossier, relatif au dossier du fichier org sauf s'il est absolu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペーストした画像の保存先：attach（エントリの添付ファイル）またはフォルダ。絶対パスでなければorgファイルのフォルダからの相対パス"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "para onde vão as imagens coladas: attach (os anexos da entrada) ou uma pasta, relativa à pasta do arquivo Org, a menos que seja absoluta"
          }
        }
      }
    },
    "whether DIR and ID inherit for attachments: selective (as org-use-property-inheritance), t or nil": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ob DIR und ID für Anhänge vererbt werden: selective (wie org-use-property-inheritance), t oder nil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "si DIR e ID se heredan para los adjuntos: selective (según org-use-property-inheritance), t o nil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "si DIR et ID sont hérités pour les pièces jointes : selective (comme org-use-property-inheritance), t ou nil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルでDIRとIDを継承するか：selective（org-use-property-inheritanceに従う）、tまたはnil"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "se DIR e ID são herdados para anexos: selective (conforme org-use-property-inheritance), t ou nil"
          }
        }
      }
    },
    "whose conventions Find Node, Insert Node Link and the daily-note commands follow: org-roam or denote": {
      "comment": "A config.toml setting, as its comment in the file describes it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wessen Konventionen „Knoten suchen“, „Knotenlink einfügen“ und die Tagesnotiz-Befehle folgen: org-roam oder denote"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "las convenciones que siguen Buscar nodo, Insertar enlace a nodo y los comandos de notas diarias: org-roam o denote"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les conventions que suivent Rechercher un nœud, Insérer un lien vers un nœud et les commandes de note quotidienne : org-roam ou denote"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードを検索、ノードリンクを挿入、デイリーノートのコマンドが従う規則：org-roamまたはdenote"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "as convenções que Buscar Nó, Inserir Link de Nó e os comandos de notas diárias seguem: org-roam ou denote"
          }
        }
      }
