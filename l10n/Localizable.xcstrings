    "Encrypt the entries with org-crypt-tag-matcher's tag on every save. Without their passphrase the file isn't saved until it's given.": {
      "comment": "Help for a config.toml setting",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge mit dem Tag aus org-crypt-tag-matcher bei jedem Sichern verschlüsseln. Ohne ihr Passwort wird die Datei erst gesichert, wenn es eingegeben ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrar las entradas con la etiqueta de org-crypt-tag-matcher en cada guardado. Sin su frase de contraseña, el archivo no se guarda hasta que se introduce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffrer les entrées portant le tag d'org-crypt-tag-matcher à chaque enregistrement. Sans leur phrase secrète, le fichier n'est pas enregistré tant qu'elle n'est pas fournie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存のたびにorg-crypt-tag-matcherのタグを持つエントリを暗号化します。パスフレーズがない場合、入力されるまでファイルは保存されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografar as entradas com a etiqueta de org-crypt-tag-matcher a cada salvamento. Sem a senha delas, o arquivo só é salvo quando ela for informada."
          }
        }
      }
    },
