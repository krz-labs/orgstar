    },
    "A theme in its own file, relative to the configuration folder. Its colors apply under the ones set in config.toml. default-theme.toml in the folder lists every color key.": {
      "comment": "Help for a config.toml setting",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Thema in einer eigenen Datei, relativ zum Konfigurationsordner. Seine Farben gelten unter denen aus config.toml. default-theme.toml im Ordner listet jeden Farbschlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema en su propio archivo, relativo a la carpeta de configuración. Sus colores se aplican por debajo de los definidos en config.toml. default-theme.toml, en esa carpeta, enumera todas las claves de color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un thème dans son propre fichier, relatif au dossier de configuration. Ses couleurs s'appliquent sous celles définies dans config.toml. default-theme.toml dans le dossier liste chaque clé de couleur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "構成フォルダからの相対パスで指定する、独自ファイルのテーマ。その色はconfig.tomlで設定した色の下に適用されます。フォルダ内のdefault-theme.tomlにすべての色キーが記載されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tema em seu próprio arquivo, relativo à pasta de configuração. Suas cores são aplicadas por baixo das definidas em config.toml. O default-theme.toml, na pasta, lista todas as chaves de cor."
          }
        }
      }
    },
