            "state": "translated",
            "value": "\\alpha erscheint als α und x_{1} wird tiefgestellt, wenn die Auszeichnung ausgeblendet ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\\alpha se muestra como α y x_{1} se baja cuando el marcado está oculto"
          }
        },
        "fr": {
