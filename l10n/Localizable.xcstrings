    "Images at http(s) links: skip doesn't show them, download fetches them and keeps them until orgstar quits, cache keeps them on disk.": {
      "comment": "Help for a config.toml setting",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder bei http(s)-Links: skip zeigt sie nicht, download lädt sie und behält sie, bis orgstar beendet wird, cache behält sie auf dem Datenträger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes en enlaces http(s): skip no las muestra, download las descarga y las conserva hasta que orgstar se cierra, cache las guarda en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images des liens http(s) : skip ne les affiche pas, download les télécharge et les garde jusqu'à ce qu'orgstar quitte, cache les garde sur le disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http(s)リンクの画像：skipは表示せず、downloadは取得してorgstarを終了するまで保持し、cacheはディスクに保持します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens em links http(s): skip não as mostra, download as baixa e as mantém até o orgstar ser encerrado, cache as mantém no disco."
          }
        }
      }
    },
