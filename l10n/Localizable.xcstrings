{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@": {
      "shouldTranslate": false
    },
    "%@\n\nThe heading and every line under it are removed from the file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nDie Überschrift und jede Zeile darunter werden aus der Datei entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEl encabezado y todas las líneas debajo se eliminan del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nLe titre et toutes les lignes situées en dessous sont supprimés du fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n見出しとその下のすべての行がファイルから削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nO cabeçalho e todas as linhas abaixo dele são removidos do arquivo."
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ (%lld)": {
      "comment": "A contact's name and the years since a date of theirs, in the agenda",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%lld）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%lld)"
          }
        }
      }
    },
    "%@ (and %lld more)": {
      "comment": "A problem with the configuration, and how many more there are",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (und %2$lld weitere)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (y %2$lld más)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (et %2$lld autres)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（ほか%2$lld件）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (e mais %2$lld)"
          }
        }
      }
    },
    "%@ (new)": {
      "comment": "Capture window: an org-roam template's file that capturing makes",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (neu)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (nuevo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (nouveau)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（新規）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (novo)"
          }
        }
      }
    },
    "%@ (orgstar+)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (orgstar+)"
          }
        },
        "es": {
