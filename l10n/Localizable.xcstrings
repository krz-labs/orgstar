          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando %@ se detuvo: su vista web terminó, como ocurre cuando un comando se queda sin memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande %@ a été arrêtée : sa vue web s’est fermée, comme lorsqu’une commande manque de mémoire."
          }
        },
        "ja": {
