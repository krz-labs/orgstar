    "Archive files are the ones your agenda files archive to, named by #+ARCHIVE:, an :ARCHIVE: property or org-archive-location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivdateien sind die Dateien, in die deine Agenda-Dateien archivieren, festgelegt durch #+ARCHIVE:, eine :ARCHIVE:-Eigenschaft oder org-archive-location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de archivo son aquellos a los que archivan tus archivos de agenda, indicados por #+ARCHIVE:, una propiedad :ARCHIVE: u org-archive-location."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers d'archive sont ceux vers lesquels vos fichiers d'agenda archivent, désignés par #+ARCHIVE:, une propriété :ARCHIVE: ou org-archive-location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブファイルとは、アジェンダファイルのアーカイブ先となるファイルで、#+ARCHIVE:、:ARCHIVE:プロパティ、またはorg-archive-locationで指定されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos de arquivamento são aqueles para os quais seus arquivos da agenda arquivam, definidos por #+ARCHIVE:, uma propriedade :ARCHIVE: ou org-archive-location."
          }
        }
      }
    },
    "Archive subtrees, publish projects, show calendars in the agenda, copy rich text, and resolve idle clock time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilbäume archivieren, Projekte veröffentlichen, Kalender in der Agenda anzeigen, formatierten Text kopieren und Leerlaufzeit der Zeiterfassung klären."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiva subárboles, publica proyectos, muestra calendarios en la agenda, copia texto con formato y resuelve el tiempo inactivo del registro de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivez des sous-arbres, publiez des projets, affichez les calendriers dans l'agenda, copiez du texte enrichi et traitez le temps d'inactivité du chronométrage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブツリーのアーカイブ、プロジェクトの公開、アジェンダでのカレンダー表示、リッチテキストのコピー、クロックのアイドル時間の処理ができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquive subárvores, publique projetos, mostre calendários na agenda, copie texto formatado e resolva o tempo ocioso do registro de tempo."
          }
        }
      }
    },
