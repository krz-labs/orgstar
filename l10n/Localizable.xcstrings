    "Flashcards are headings tagged fc, in org-fc's format. Make one with Make Normal Flashcard or another Make Flashcard command.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernkarten sind Überschriften mit dem Tag fc im Format von org-fc. Erstelle eine mit „Normale Lernkarte erstellen“ oder einem anderen Befehl zum Erstellen von Lernkarten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas son encabezados con la etiqueta fc, en el formato de org-fc. Crea una con Crear tarjeta normal u otra orden para crear tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fiches sont des titres portant l'étiquette fc, au format d'org-fc. Créez-en une avec Créer une fiche normale ou une autre commande de création de fiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フラッシュカードは、タグ fc の付いた見出しで、org-fc の形式です。「通常のフラッシュカードにする」などのコマンドで作成します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flashcards são títulos com a etiqueta fc, no formato do org-fc. Crie um com Criar Flashcard Normal ou outro comando de criar flashcard."
          }
        }
      }
    },
