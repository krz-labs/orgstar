    "Insert citations from your bibliography, complete keys after @, follow a citation to its entry, and open Zotero links.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Zitate aus deiner Bibliografie ein, vervollständige Schlüssel nach @, folge einem Zitat zu seinem Eintrag und öffne Zotero-Links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta citas de tu bibliografía, completa claves después de @, sigue una cita hasta su entrada y abre enlaces de Zotero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérez des citations depuis votre bibliographie, complétez les clés après @, suivez une citation jusqu'à son entrée et ouvrez les liens Zotero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考文献から引用を挿入し、@ の後でキーを補完し、引用からその項目へ移動し、Zotero リンクを開けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira citações da sua bibliografia, complete chaves depois de @, siga uma citação até a entrada dela e abra links do Zotero."
          }
        }
      }
    },
