    "It isn't in one of your folders. Grant access to it to continue.": {
      "comment": "Alert for a folder outside the sidebar's folders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er liegt in keinem deiner Ordner. Erlaube den Zugriff, um fortzufahren."
          }
        },
        "es": {
