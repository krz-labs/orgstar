    "Widgets need orgstar+.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets erfordern orgstar+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets requieren orgstar+."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets nécessitent orgstar+."
          }
        },
        "ja": {
          "stringUnit": {
