    "Renews while you sponsor monthly. This key is valid until %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verlängert, solange du monatlich sponserst. Dieser Schlüssel gilt bis %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva mientras patrocines cada mes. Esta clave es válida hasta el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelée tant que vous sponsorisez chaque mois. Cette clé est valable jusqu'au %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月スポンサーを続けている間は更新されます。このキーは%@まで有効です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É renovada enquanto você patrocina mensalmente. Esta chave é válida até %@."
          }
        }
      }
    },
    "Sponsor for orgstar+…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für orgstar+ sponsern …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrocinar para orgstar+…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponsoriser pour orgstar+…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポンサーになってorgstar+を利用…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrocinar para o orgstar+…"
          }
        }
      }
    },
    "Sponsors get their key by signing in with GitHub. It is checked on this Mac; a monthly sponsor's key is renewed with krz.sh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponsoren erhalten ihren Schlüssel, indem sie sich mit GitHub anmelden. Er wird auf diesem Mac geprüft; der Schlüssel monatlicher Sponsoren wird über krz.sh verlängert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrocinadores obtienen su clave iniciando sesión con GitHub. Se comprueba en este Mac; la clave de un patrocinador mensual se renueva con krz.sh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sponsors obtiennent leur clé en se connectant avec GitHub. Elle est vérifiée sur ce Mac ; la clé d'un sponsor mensuel est renouvelée auprès de krz.sh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポンサーはGitHubでサインインしてキーを取得します。キーはこのMac上で確認されます。月額スポンサーのキーはkrz.shで更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os patrocinadores obtêm a chave entrando com o GitHub. Ela é verificada neste Mac; a chave de um patrocinador mensal é renovada com o krz.sh."
          }
        }
      }
    },
    "This copy of orgstar has no command-line tool.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie von orgstar enthält kein Befehlszeilenwerkzeug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de orgstar no tiene herramienta de línea de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie d’orgstar n’a pas d’outil en ligne de commande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この orgstar にはコマンドラインツールが含まれていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia do orgstar não tem ferramenta de linha de comando."
          }
        }
      }
    },
    "git isn't installed. Install the Xcode command line tools or git from Homebrew.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "git ist nicht installiert. Installiere die Xcode-Befehlszeilentools oder git aus Homebrew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "git no está instalado. Instala las herramientas de línea de comandos de Xcode o git desde Homebrew."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "git n’est pas installé. Installez les outils en ligne de commande de Xcode ou git depuis Homebrew."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git がインストールされていません。Xcode コマンドラインツールか Homebrew の git をインストールしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O git não está instalado. Instale as ferramentas de linha de comando do Xcode ou o git do Homebrew."
          }
        }
      }
    },
    "orgstar can't write in %@: %@. Choose a folder of your own, such as ~/.local/bin, or make the link in Terminal: sudo ln -sf '%@' '%@/orgstar'": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar kann nicht in %1$@ schreiben: %2$@. Wähle einen eigenen Ordner, etwa ~/.local/bin, oder lege den Link im Terminal an: sudo ln -sf '%3$@' '%4$@/orgstar'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar no puede escribir en %1$@: %2$@. Elige una carpeta tuya, como ~/.local/bin, o crea el enlace en Terminal: sudo ln -sf '%3$@' '%4$@/orgstar'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar ne peut pas écrire dans %1$@ : %2$@. Choisissez un dossier à vous, comme ~/.local/bin, ou créez le lien dans le Terminal : sudo ln -sf '%3$@' '%4$@/orgstar'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar は %1$@ に書き込めません: %2$@。~/.local/bin など自分のフォルダを選ぶか、ターミナルでリンクを作成してください: sudo ln -sf '%3$@' '%4$@/orgstar'"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar não pode gravar em %1$@: %2$@. Escolha uma pasta sua, como ~/.local/bin, ou crie o link no Terminal: sudo ln -sf '%3$@' '%4$@/orgstar'"
          }
        }
      }
    },
    "orgstar+ for Mac comes with sponsoring orgstar on GitHub: $60 once, or $5 a month. Editing, the agenda, capture, clocking and search stay free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar+ für Mac gibt es, wenn du orgstar auf GitHub sponserst: einmalig $60 oder $5 im Monat. Bearbeiten, Agenda, Erfassen, Zeiterfassung und Suche bleiben kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar+ para Mac se incluye al patrocinar orgstar en GitHub: $60 una vez o $5 al mes. La edición, la agenda, la captura, el registro de tiempo y la búsqueda siguen siendo gratuitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar+ pour Mac est inclus quand vous sponsorisez orgstar sur GitHub : $60 une fois, ou $5 par mois. L'édition, l'agenda, la capture, le chronométrage et la recherche restent gratuits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac版orgstar+は、GitHubでorgstarのスポンサーになると利用できます（1回$60、または月額$5）。編集、アジェンダ、キャプチャ、クロック、検索は引き続き無料です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar+ para Mac vem com o patrocínio do orgstar no GitHub: $60 uma vez ou $5 por mês. A edição, a agenda, a captura, o registro de tempo e a busca continuam gratuitos."
          }
        }
      }
    }
  },
  "version": "1.1"
}
