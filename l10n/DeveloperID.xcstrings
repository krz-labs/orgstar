    "Choose a folder on your PATH for the orgstar command, such as ~/.local/bin or /usr/local/bin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner in deinem PATH für den Befehl orgstar, etwa ~/.local/bin oder /usr/local/bin."
