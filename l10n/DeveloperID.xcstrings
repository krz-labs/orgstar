    "Didn't commit in %@: a git %@ is in progress. Finish or abort it; orgstar commits after the next save.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Commit in %1$@: Ein git-%2$@ läuft. Schließe ihn ab oder brich ihn ab; orgstar committet nach dem nächsten Sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confirmó en %1$@: hay un %2$@ de git en curso. Termínalo o cancélalo; orgstar confirmará tras el próximo guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune validation dans %1$@ : un %2$@ git est en cours. Terminez-le ou annulez-le ; orgstar validera après le prochain enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ でコミットしませんでした: git の %2$@ が進行中です。完了するか中止してください。次の保存後にコミットします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum commit em %1$@: um %2$@ do git está em andamento. Conclua ou cancele; o orgstar fará commit após o próximo salvamento."
          }
        }
      }
    },
    "Didn't commit in %@: another git command is running there. orgstar tries again after the next save.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Commit in %@: Dort läuft ein anderer git-Befehl. orgstar versucht es nach dem nächsten Sichern erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confirmó en %@: hay otro comando git en ejecución. orgstar lo intentará de nuevo tras el próximo guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune validation dans %@ : une autre commande git y est en cours. orgstar réessaiera après le prochain enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でコミットしませんでした: 別の git コマンドが実行中です。次の保存後に再試行します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum commit em %@: outro comando git está em execução. O orgstar tentará de novo após o próximo salvamento."
          }
        }
      }
    },
