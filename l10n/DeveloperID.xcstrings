    "Links the orgstar command into a folder on your PATH, to print the agenda, capture, clock in and out, and export from Terminal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlinkt den Befehl orgstar in einen Ordner in deinem PATH, um im Terminal die Agenda auszugeben, zu erfassen, die Uhr zu starten und zu stoppen und zu exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaza el comando orgstar en una carpeta de tu PATH para mostrar la agenda, capturar, iniciar y detener el reloj y exportar desde Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un lien vers la commande orgstar dans un dossier de votre PATH, pour afficher l’agenda, capturer, démarrer et arrêter l’horloge et exporter depuis le Terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar コマンドへのリンクを PATH 上のフォルダに作成し、ターミナルからアジェンダの表示、キャプチャ、時間計測の開始と終了、書き出しができるようにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um link para o comando orgstar em uma pasta do seu PATH, para mostrar a agenda, capturar, iniciar e parar o relógio e exportar pelo Terminal."
          }
        }
      }
    },
